print("Incluye el resultado al final de cada fila.\n")

for i in range(n):
    while True:
        try:
            fila = list(map(float, input(f"Fila {i+1}: ").split()))

            if len(fila) == n + 1:
                A.append(fila)
                break
            else:
                print(f"Debes ingresar {n+1} numeros.")

        except ValueError:
            print("Ingresa solamente numeros validos.")

metodo_jacobi(A, n)

